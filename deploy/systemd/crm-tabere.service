[Unit]
Description=CRM Tabere (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
NotifyAccess=main
User=crm
Group=www-data
WorkingDirectory=/srv/crm-tabere/app
ExecStart=/srv/crm-tabere/venv/bin/gunicorn config.wsgi:application -c /srv/crm-tabere/app/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=crm-tabere
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/crm-tabere/media

[Install]
WantedBy=multi-user.target
