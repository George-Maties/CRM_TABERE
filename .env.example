# Copiați în .env și completați. Fișierul .env nu intră în git.

# Generare: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=schimbati-ma

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Producție: CSRF_TRUSTED_ORIGINS=https://crm.domeniu.ro
CSRF_TRUSTED_ORIGINS=

DB_NAME=crm_tabere
DB_USER=crm_tabere
DB_PASSWORD=parola
DB_HOST=localhost
DB_PORT=5432

